---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectTeaser from '../../components/ProjectTeaser.astro';
import ContextBadge from '../../components/ContextBadge.astro';
import { languages, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getVisibleProjects } from '../../data/projects';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const projects = await getVisibleProjects();

const contexts = ['independent', 'macmac', 'marvelous'] as const;
const counts = Object.fromEntries(
  contexts.map((c) => [c, projects.filter((p) => p.data.context === c).length]),
);

// The "Your project?" teaser sits after this many projects (fewer projects: it comes last).
const TEASER_AFTER = 4;
const at = Math.min(TEASER_AFTER, projects.length);
const entries = [
  ...projects.slice(0, at).map((project, i) => ({ kind: 'project' as const, project, i })),
  { kind: 'teaser' as const, at },
  ...projects.slice(at).map((project, j) => ({ kind: 'project' as const, project, i: at + j })),
];
---

<BaseLayout
  title={t('workPage.title')}
  description={t('workPage.description')}
  shareImage="work"
  lang={lang}
>
  <section class="border-b border-line bg-paper pb-24 pt-20 md:pb-32 md:pt-28">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <header class="grid gap-8 md:grid-cols-[1fr_minmax(0,22rem)] md:items-end md:gap-16">
        <div>
          <h1 class="font-display text-headline text-ink">{t('workPage.heading')}</h1>
          <p class="mt-5 max-w-2xl text-lead text-muted">{t('workPage.intro')}</p>
        </div>

        {/* Legend doubles as a filter once JS is available (no JS: not shown). */}
        <div class="work-filter" data-filter>
          <div
            role="group"
            aria-label={t('workPage.filterLabel')}
            class="flex flex-wrap gap-2 font-mono text-caption uppercase"
          >
            <button type="button" class="chip" data-filter-value="all" aria-pressed="true">
              {t('workPage.filterAll')}
              <span class="text-muted">{projects.length}</span>
            </button>
            {contexts.map((c) => (
              <button type="button" class="chip" data-filter-value={c} aria-pressed="false">
                <ContextBadge context={c} lang={lang} />
                <span class="text-muted">{counts[c]}</span>
              </button>
            ))}
          </div>
        </div>
      </header>

      <p
        class="sr-only"
        aria-live="polite"
        data-filter-status
        data-template={t('workPage.filterStatus')}
      ></p>

      <h2 class="sr-only">{t('workPage.listHeading')}</h2>
      <ul class="mt-16 grid gap-x-10 gap-y-20 md:mt-24 md:grid-cols-2 md:gap-y-24" role="list">
        {entries.map((entry) =>
          entry.kind === 'teaser' ? (
            /* No data-context, so the filter leaves it visible under every chip. */
            <li data-reveal data-reveal-delay={String((entry.at % 2) + 1)}>
              <ProjectTeaser lang={lang} />
            </li>
          ) : (
            <li
              data-context={entry.project.data.context}
              data-reveal
              data-reveal-delay={String((entry.i % 2) + 1)}
            >
              <ProjectCard
                project={entry.project}
                lang={lang}
                eager={entry.i < 2}
                fxSlot="workMedia"
              />
            </li>
          ),
        )}
      </ul>
    </div>
  </section>

  <script>
    import '../../components/islands/reveal.ts';
    import '../../components/islands/work-filter.ts';
  </script>
</BaseLayout>

<style>
  /* Without JS there is no filter. With JS it holds its room from the first
     paint and shows once work-filter.ts is ready, so the list below doesn't
     jump down when it appears (that was the page's layout shift on phones). */
  :global(html:not(.js)) .work-filter {
    display: none;
  }
  .work-filter:not(.is-ready) {
    visibility: hidden;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .chip:hover {
    border-color: var(--color-muted);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-surface-2);
    border-color: var(--color-ink);
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceBlocks from '../../components/ServiceBlocks.astro';
import SelectedWork from '../../components/SelectedWork.astro';
import Approach from '../../components/Approach.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import { languages, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('home.title')} description={t('home.description')} lang={lang}>
  <Hero lang={lang} />
  <ServiceBlocks lang={lang} />
  <Approach lang={lang} />
  <HowItWorks lang={lang} />
  <SelectedWork lang={lang} />

  {/* Scroll-reveal island (Vite-bundled; runs client-side, progressive enhancement). */}
  <script>
    import '../../components/islands/reveal.ts';
  </script>
</BaseLayout>

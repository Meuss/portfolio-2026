---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../../components/NotFound.astro';
import { languages, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

// Served by Netlify for unknown URLs under each locale (see netlify.toml).
export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('notFound.title')} description={t('notFound.description')} lang={lang} noindex>
  <NotFound lang={lang} />
</BaseLayout>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer, { type FooterVariant } from '../components/Footer.astro';
import { languages, type Lang } from '../i18n/ui';
import { switchLocalePath, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Error pages: kept out of search and without canonical/alternate links. */
  noindex?: boolean;
  /** Which footer closes the page (see Footer.astro): 'full' by default,
      'compact' on the error pages, 'fine-print' on the contact page. */
  footer?: FooterVariant;
}

const { title, description, lang, noindex = false, footer = 'full' } = Astro.props;
const t = useTranslations(lang);

// Canonical production origin, sourced from `site` in astro.config.mjs so
// there's a single source of truth. Falls back to the production domain if
// Astro.site is ever undefined (e.g. misconfiguration).
const siteUrl = Astro.site?.toString() ?? 'https://thomasmiller.ch';

const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogLocale = lang === 'en' ? 'en_US' : 'fr_FR';
const ogLocaleAlternate = lang === 'en' ? 'fr_FR' : 'en_US';

const locales = Object.keys(languages) as Lang[];
const alternateLinks = locales.map((l) => ({
  lang: l,
  href: new URL(switchLocalePath(Astro.url, l), siteUrl).toString(),
}));
const xDefaultHref = new URL(switchLocalePath(Astro.url, 'en'), siteUrl).toString();
const ogImage = new URL('/og-image.png', siteUrl).toString();
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Mark JS as available before paint so the scroll-reveal hidden state only
        applies when JS can reveal it — no-JS users see all content, no flash. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* The page ground: --color-paper in global.css (also in site.webmanifest). */}
    <meta name="theme-color" content="#121212" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalURL} />

        {alternateLinks.map((alt) => (
          <link rel="alternate" hreflang={alt.lang} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thomas Miller" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink"
    >
      {t('nav.skipToContent')}
    </a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} variant={footer} />

    {/* Effects runtime: mounts the effects listed in islands/fx/effects.ts into
        every [data-fx-slot]. */}
    <script>
      import '../components/islands/fx/runtime.ts';
    </script>
  </body>
</html>

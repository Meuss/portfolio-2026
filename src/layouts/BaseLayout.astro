---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer, { type FooterVariant } from '../components/Footer.astro';
import { languages, type Lang } from '../i18n/ui';
import { switchLocalePath, useTranslations } from '../i18n/utils';
import { goatcounterCode, goatcounterEndpoint } from '../data/analytics';
import { ogLocale, shareImage, shareImageAlt, shareImagePath, type SharePage } from '../data/share';
import { serializeJsonLd, structuredData } from '../data/structured-data';
import { getImage } from 'astro:assets';
import portrait from '../assets/profile.jpeg';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Error pages: kept out of search and without canonical/alternate links. */
  noindex?: boolean;
  /** Which footer closes the page (see Footer.astro): 'full' by default,
      'compact' on the error pages, 'fine-print' on the contact page. */
  footer?: FooterVariant;
  /** Link preview (Open Graph): the page's share image (src/data/share.ts),
      the home one by default, and a share title/description when they should
      differ from the page's title and meta description. */
  shareImage?: SharePage;
  shareTitle?: string;
  shareDescription?: string;
}

const {
  title,
  description,
  lang,
  noindex = false,
  footer = 'full',
  shareImage: sharePage = 'home',
  shareTitle = title,
  shareDescription = description,
} = Astro.props;
const t = useTranslations(lang);

// Canonical production origin, sourced from `site` in astro.config.mjs so
// there's a single source of truth. Falls back to the production domain if
// Astro.site is ever undefined (e.g. misconfiguration).
const siteUrl = Astro.site?.toString() ?? 'https://thomasmiller.ch';

const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

const locales = Object.keys(languages) as Lang[];
const alternateLinks = locales.map((l) => ({
  lang: l,
  href: new URL(switchLocalePath(Astro.url, l), siteUrl).toString(),
}));
const xDefaultHref = new URL(switchLocalePath(Astro.url, 'en'), siteUrl).toString();
const ogImage = new URL(shareImagePath(lang, sharePage), siteUrl).toString();
const ogImageAlt = shareImageAlt(lang, sharePage);

// Structured data (src/data/structured-data.ts) on indexable pages only. The
// share page (`shareImage`) names the page, which sets its schema.org type.
const jsonLd = noindex
  ? null
  : serializeJsonLd(
      structuredData({
        lang,
        page: sharePage,
        site: siteUrl,
        url: canonicalURL,
        title,
        description,
        businessDescription: t('home.description'),
        logo: new URL('/icon-512.png', siteUrl).toString(),
        image: new URL(shareImagePath(lang, 'home'), siteUrl).toString(),
        portrait: new URL(
          (await getImage({ src: portrait, width: 800, format: 'jpg' })).src,
          siteUrl,
        ).toString(),
      }),
    );

// Visitor counting (src/data/analytics.ts): production builds only, and only
// with a code set. GoatCounter reports the canonical URL's path, so /en/… and
// /fr/… count separately. noindex pages (404, form success) have no canonical:
// they report their own built path instead, so every unknown URL counts as
// /en/404/ or /fr/404/ rather than as a page of its own.
const goatcounterUrl = import.meta.env.PROD ? goatcounterEndpoint(goatcounterCode) : null;
const goatcounterSettings = noindex ? JSON.stringify({ path: Astro.url.pathname }) : undefined;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Mark JS as available before paint so the scroll-reveal hidden state only
        applies when JS can reveal it — no-JS users see all content, no flash. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* The page ground: --color-paper in global.css (also in site.webmanifest). */}
    <meta name="theme-color" content="#121212" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalURL} />

        {alternateLinks.map((alt) => (
          <link rel="alternate" hreflang={alt.lang} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
      </>
    )}

    {/* Link previews. X reads og:title, og:description and og:image too, so
        only the card type and the image's alt text get twitter: tags. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thomas Miller" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales
      .filter((l) => l !== lang)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocale[l]} />
      ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={shareImage.type} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    {goatcounterUrl && (
      <script
        is:inline
        data-goatcounter={goatcounterUrl}
        data-goatcounter-settings={goatcounterSettings}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink"
    >
      {t('nav.skipToContent')}
    </a>
    <Header lang={lang} />
    {/* tabindex="-1" so the skip link really moves focus here (no ring on main itself). */}
    <main id="main-content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer lang={lang} variant={footer} />

    {/* Effects runtime: mounts the effects listed in islands/fx/effects.ts into
        every [data-fx-slot]. */}
    <script>
      import '../components/islands/fx/runtime.ts';
    </script>
  </body>
</html>

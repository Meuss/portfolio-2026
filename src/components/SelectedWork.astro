---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';
import ProjectCard from './ProjectCard.astro';
import Arrow from './icons/Arrow.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const all = await getCollection('projects');
const featured = all
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const workHref = localizedPath(lang, '/work');
---

<section class="border-b border-line bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="font-display text-headline text-ink">{t('work.heading')}</h2>
        <p class="mt-5 text-lead text-muted">{t('work.intro')}</p>
      </div>
    </header>

    <ul class="mt-14 grid gap-x-8 gap-y-16 md:mt-20 md:grid-cols-3" role="list">
      {featured.map((project, i) => (
        <li data-reveal data-reveal-delay={String((i % 3) + 1)}>
          <ProjectCard project={project} lang={lang} />
        </li>
      ))}
    </ul>

    <div class="mt-20 flex justify-end border-t border-line pt-8">
      <a href={workHref} class="btn-secondary group">
        {t('work.viewAll')}
        <Arrow class="transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>
    </div>
  </div>
</section>

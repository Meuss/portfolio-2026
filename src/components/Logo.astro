---
/**
 * The kit symbol, "Sommet qui perce": an orange ring, open at the top, with the
 * Moléson's tall peak breaking out through the gap (geometry in brand/README.md).
 * Drawn inline beside the name and tagline, which stay live text (styles under
 * "Logo" in global.css). Set --logo-size on it to change the symbol's size; the
 * rest scales with it. Decorative: the caller labels the link around it.
 */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<span class:list={['brand-logo', className]} aria-hidden="true">
  <svg class="brand-mark" viewBox="0 0 64 64" focusable="false">
    <path class="brand-mark-ring" d="M43.74 11.93 A25 25 0 1 1 14.89 15.77"></path>
    <path class="brand-mark-peaks" d="M17 45 L25.5 30 L31 38 L38.5 7 L47.5 45"></path>
  </svg>
  <span class="brand-text">
    <span class="brand-name">Thomas Miller</span>
    <span class="brand-tagline">{t('brand.tagline')}</span>
  </span>
</span>

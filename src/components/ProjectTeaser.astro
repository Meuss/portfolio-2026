---
import type { Lang } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';
import ProjectFrame from './ProjectFrame.astro';
import Arrow from './icons/Arrow.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactHref = localizedPath(lang, '/contact');
---

{/* Closes the /work grid: laid out like a ProjectCard, with an open slot
    instead of a screenshot. Same hit-target pattern as the card: the frame
    link is aria-hidden and out of tab order, the title link is the real one. */}
<article class="teaser group grid gap-8">
  <div class="pb-5">
    <a href={contactHref} tabindex="-1" aria-hidden="true">
      <ProjectFrame alt="">
        <span slot="blank" class="font-mono text-caption uppercase text-muted">
          {t('work.teaser.frame')}
        </span>
      </ProjectFrame>
    </a>
  </div>

  <div class="flex flex-col gap-4">
    <p class="font-mono text-caption uppercase text-muted">{t('work.teaser.kind')}</p>

    <h3 class="font-display text-title text-ink">
      <a href={contactHref} class="teaser-link text-ink no-underline">
        {t('work.teaser.title')}
      </a>
    </h3>

    <p class="max-w-[60ch] text-body text-muted">{t('work.teaser.body')}</p>

    <div class="pt-1 font-mono text-caption uppercase">
      <span class="inline-flex items-center gap-2 text-accent" aria-hidden="true">
        {t('cta.button')}
        <Arrow class="arrow" />
      </span>
    </div>
  </div>
</article>

<style>
  .teaser-link {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .teaser:hover .teaser-link,
  .teaser-link:focus-visible {
    background-size: 100% 1px;
  }
  .teaser :global(.arrow) {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .teaser:hover :global(.arrow) {
    transform: translateX(2px);
  }
</style>

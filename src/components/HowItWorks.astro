---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [1, 2, 3, 4].map((n) => ({
  title: t(`how.step${n}.title`),
  text: t(`how.step${n}.text`),
}));

// The array is the display order of the FAQ questions.
const questions = [1, 2, 6, 4, 3, 5, 8, 7].map((n) => ({
  question: t(`how.faq${n}.q`),
  answer: t(`how.faq${n}.a`),
}));

// Two independent stacks from `lg` (read down the first, then the second), so
// an opened answer only moves the rows of its own column.
const half = Math.ceil(questions.length / 2);
const faqColumns = [questions.slice(0, half), questions.slice(half)];
---

<section id="how-it-works" class="border-b border-line bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <header class="max-w-3xl">
      <h2 class="font-display text-headline text-ink">{t('how.heading')}</h2>
      <p class="mt-5 text-lead text-muted">{t('how.intro')}</p>
    </header>

    <!-- Timeline: one hairline track with a marker per step. A row of four from
         `xl` (narrower columns break the French titles over three lines); below,
         the track runs down the left and the steps stack beside it.
         The `howTimeline` effect adds the orange scroll fill (track and markers
         are decorative; the <ol> carries the order). -->
    <div class="relative mt-12 md:mt-16" data-fx-slot="howTimeline">
      <span
        class="timeline-track absolute bottom-0 left-[3px] top-[7px] w-px bg-line xl:inset-x-0 xl:bottom-auto xl:top-[3px] xl:h-px xl:w-auto"
        aria-hidden="true"
      ></span>
      <ol class="grid gap-10 xl:grid-cols-4 xl:gap-7" role="list">
        {steps.map((step, i) => (
          <li class="relative pl-8 xl:pl-0 xl:pt-7">
            <span
              class="timeline-marker absolute left-0 top-[7px] size-[7px] rounded-full bg-muted xl:top-0"
              aria-hidden="true"
            />
            <span class="block font-mono text-small text-muted" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="mt-2 font-display text-title text-ink">{step.title}</h3>
            <p class="mt-3 max-w-2xl text-body text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-16 md:mt-20" data-reveal>
      <h3 class="font-mono text-caption uppercase text-muted">{t('how.faqHeading')}</h3>
      <div class="mt-5 grid lg:grid-cols-2 lg:items-start lg:gap-x-16">
        {faqColumns.map((column, c) => (
          <div
            class:list={['border-line', c === faqColumns.length - 1 ? 'border-b' : 'lg:border-b']}
          >
            {column.map((item) => (
              <details class="faq-item group border-t border-line">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-sm py-5 text-lead text-ink transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
                  <span>{item.question}</span>
                  <svg
                    class="size-4 shrink-0 transition-transform duration-200 group-open:rotate-45"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="square"
                    aria-hidden="true"
                  >
                    <path d="M8 2v12M2 8h12" />
                  </svg>
                </summary>
                <p class="max-w-2xl pb-6 text-body text-muted">{item.answer}</p>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

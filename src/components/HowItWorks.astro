---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [1, 2, 3, 4].map((n) => ({
  title: t(`how.step${n}.title`),
  text: t(`how.step${n}.text`),
}));

// The array is the display order of the FAQ questions.
const questions = [1, 2, 6, 4, 3, 5, 8, 7].map((n) => ({
  question: t(`how.faq${n}.q`),
  answer: t(`how.faq${n}.a`),
}));

// Two independent stacks from `lg` (read down the first, then the second), so
// an opened answer only moves the rows of its own column.
const half = Math.ceil(questions.length / 2);
const faqColumns = [questions.slice(0, half), questions.slice(half)];
---

<section id="how-it-works" class="border-b border-line bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <header class="max-w-3xl">
      <h2 class="font-display text-headline text-ink">{t('how.heading')}</h2>
      <p class="mt-5 text-lead text-muted">{t('how.intro')}</p>
    </header>

    <!-- Timeline: one hairline track that the step numerals interrupt, like
         stations on a route (each numeral sits on a paper ground that hides the
         track behind it). A row of four from `xl` (narrower columns break the
         French titles over three lines); below, the track runs down the left
         through the numerals and the steps stack beside it.
         The numerals sit between the Title and Headline sizes (`--step-num`).
         The track takes the same font size, so its em offsets land on their
         middle: half the line box across the row, half the two tabular digits
         (2 × 0.635em, untracked so their outlines never touch) down the stack.
         After the last numeral the line is open-ended ("I stay on"): a tail
         that is solid for its first half, then dashes that fade out. The tail
         lies over the end of the track on a paper ground and draws that
         stretch itself; in the stack it runs on a little below the last step.
         The `howTimeline` effect adds the orange scroll fill (tail included)
         and holds each numeral as an outline until the fill reaches it. Track,
         tail and numerals are decorative; the <ol> carries the order. -->
    <div
      class="relative mt-12 [--step-num:clamp(1.75rem,1.2rem_+_2.4vw,3.125rem)] md:mt-16"
      data-fx-slot="howTimeline"
    >
      <span
        class="timeline-track absolute bottom-0 left-[0.635em] top-0 w-px bg-line text-[length:var(--step-num)] xl:bottom-auto xl:left-0 xl:right-0 xl:top-[0.5em] xl:h-px xl:w-auto"
        aria-hidden="true"
      ></span>
      <ol class="grid gap-y-10 xl:grid-cols-4 xl:gap-x-7 xl:gap-y-0" role="list">
        {steps.map((step, i) => (
          <li class="relative grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-4 md:gap-x-6 xl:row-span-3 xl:grid-cols-1 xl:grid-rows-subgrid xl:items-start">
            <span
              class="timeline-marker relative -my-2 bg-paper py-2 font-display text-[length:var(--step-num)] font-extrabold leading-none tracking-normal tabular-nums text-ink xl:-mx-4 xl:my-0 xl:justify-self-start xl:px-4 xl:py-0"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            {i === steps.length - 1 && (
              <span
                class="absolute -bottom-10 left-[calc(0.635em_-_2px)] top-[calc(1em_+_0.5rem)] w-[5px] bg-paper text-[length:var(--step-num)] xl:bottom-auto xl:left-[calc(1.27em_+_1rem)] xl:right-0 xl:top-[calc(0.5em_-_2px)] xl:h-[5px] xl:w-auto"
                aria-hidden="true"
              >
                <span class="timeline-tail absolute inset-y-0 left-px w-[2px] [--tail-dir:to_bottom] [--tail-end:0_100%] [--tail-half:100%_50%] xl:bottom-auto xl:left-0 xl:right-0 xl:top-px xl:h-[2px] xl:w-auto xl:[--tail-dir:to_right] xl:[--tail-end:100%_0] xl:[--tail-half:50%_100%]">
                  <span class="absolute inset-y-0 left-px w-px bg-line xl:bottom-auto xl:left-0 xl:right-0 xl:top-px xl:h-px xl:w-auto" />
                </span>
              </span>
            )}
            <h3 class="font-display text-title text-ink xl:mt-5">{step.title}</h3>
            <p class="col-start-2 mt-2 max-w-2xl text-body text-muted xl:col-start-1">
              {step.text}
            </p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-16 md:mt-20" data-reveal>
      <h3 class="font-mono text-caption uppercase text-muted">{t('how.faqHeading')}</h3>
      <div class="mt-5 grid lg:grid-cols-2 lg:items-start lg:gap-x-16">
        {faqColumns.map((column, c) => (
          <div
            class:list={['border-line', c === faqColumns.length - 1 ? 'border-b' : 'lg:border-b']}
          >
            {column.map((item) => (
              <details class="faq-item group border-t border-line">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-sm py-5 text-lead text-ink transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
                  <span>{item.question}</span>
                  <svg
                    class="size-4 shrink-0 transition-transform duration-200 group-open:rotate-45"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="square"
                    aria-hidden="true"
                  >
                    <path d="M8 2v12M2 8h12" />
                  </svg>
                </summary>
                <p class="max-w-2xl pb-6 text-body text-muted">{item.answer}</p>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* The tail's shape, as a mask over whatever is drawn in it (the neutral line
     and, when the effect runs, its orange fill): the first half solid, the
     second half regular dashes that fade out. Direction and halves come from
     the custom properties set on the element (down the stack, across the row).
     The black in the gradients is mask alpha, not a colour on screen. */
  .timeline-tail {
    mask-image:
      linear-gradient(#000, #000),
      repeating-linear-gradient(var(--tail-dir), transparent 0 6px, #000 6px 14px),
      linear-gradient(var(--tail-dir), #000 40%, transparent);
    mask-size: var(--tail-half);
    mask-position:
      0 0,
      var(--tail-end),
      var(--tail-end);
    mask-repeat: no-repeat;
    mask-composite: add, intersect;
  }
</style>

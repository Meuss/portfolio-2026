---
import type { Lang } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeHref = localizedPath(lang, '/');
const navItems = [
  { href: localizedPath(lang, '/about'), label: t('nav.about') },
  { href: localizedPath(lang, '/work'), label: t('nav.work') },
  { href: localizedPath(lang, '/contact'), label: t('nav.contact') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href.replace(/\/$/, '') === currentPath;
---

<header class="site-header sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-4 px-6 py-4 md:flex-nowrap md:px-10">
    <a
      href={homeHref}
      class="relative flex items-center text-ink"
      aria-label={`Thomas Miller — ${t('nav.home')}`}
      aria-current={isActive(homeHref) ? 'page' : undefined}
    >
      <Logo lang={lang} />
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="nav-toggle relative -me-2.5 inline-flex h-11 w-11 items-center justify-center rounded-sm md:hidden"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label={t('nav.menuOpen')}
      data-label-open={t('nav.menuOpen')}
      data-label-close={t('nav.menuClose')}
    >
      <span aria-hidden="true" class="nav-toggle-bar nav-toggle-bar--long"></span>
      <span aria-hidden="true" class="nav-toggle-bar nav-toggle-bar--short"></span>
    </button>

    <div id="primary-nav" class="nav-panel flex md:w-auto md:flex-row md:items-center md:gap-8">
      <nav
        aria-label={t('nav.primary')}
        class="nav-links flex flex-col md:flex-row md:items-center md:gap-8"
      >
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-body text-ink hover:text-accent"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <LanguageSwitcher lang={lang} class="max-md:hidden" />
      <LanguageSwitcher lang={lang} variant="menu" class="md:hidden" />
    </div>
  </div>
</header>

<style>
  /* The mobile menu (below 768px). One motion, opening and closing alike:
     the sheet fades while its content settles down by a few pixels, on the
     site's ease-out curve; the toggle's two strokes turn into an X on the same
     curve and duration. Only opacity and transform move; `visibility` takes the
     closed sheet out of the tab order once it has faded. Everything is driven by
     the toggle's `aria-expanded`. */
  .site-header {
    --menu-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --menu-in: 280ms;
    --menu-out: 200ms;
  }

  /* Toggle: a long ink stroke over a short orange one, flush right; open, both
     turn into the arms of an X. */
  .nav-toggle-bar {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.375rem;
    height: 0.09375rem;
    margin: -0.046875rem 0 0 -0.6875rem;
    background: var(--color-ink);
    transition: transform var(--menu-out) var(--menu-ease);
  }
  .nav-toggle-bar--long {
    transform: translate(0, -0.25rem) rotate(0) scaleX(1);
  }
  .nav-toggle-bar--short {
    background: var(--color-accent);
    transform: translate(0.34375rem, 0.25rem) rotate(0) scaleX(0.5);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar {
    transition-duration: var(--menu-in);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar--long {
    transform: translate(0, 0) rotate(45deg) scaleX(1);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar--short {
    transform: translate(0, 0) rotate(-45deg) scaleX(1);
  }

  @media (width < 48rem) {
    .nav-panel {
      position: absolute;
      /* Just under the bar's bottom hairline (100% stops at its padding box). */
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      height: calc(100dvh - var(--menu-top, 4.3rem));
      flex-direction: column;
      justify-content: space-between;
      gap: 2.5rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 2.5rem 1.5rem 2rem;
      background: var(--color-paper);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--menu-out) var(--menu-ease),
        visibility 0s linear var(--menu-out);
    }
    .nav-panel > :global(*) {
      transform: translateY(-0.75rem);
      transition: transform var(--menu-out) var(--menu-ease);
    }
    .nav-toggle[aria-expanded='true'] ~ .nav-panel {
      opacity: 1;
      visibility: visible;
      transition:
        opacity var(--menu-in) var(--menu-ease),
        visibility 0s;
    }
    .nav-toggle[aria-expanded='true'] ~ .nav-panel > :global(*) {
      transform: none;
      transition-duration: var(--menu-in);
    }

    .nav-links {
      gap: 0.25rem;
    }
    .nav-links a {
      display: block;
      padding: 0.35rem 0;
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 11vw, 3.75rem);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.035em;
      border-bottom: 1px solid var(--color-line);
    }
    .nav-links a[aria-current='page'] {
      color: var(--color-accent);
    }

    /* Without JS the toggle can't do anything: drop it and show the menu in
       the page flow instead. */
    :global(html:not(.js)) .nav-toggle {
      display: none;
    }
    :global(html:not(.js)) .nav-panel {
      position: static;
      width: 100%;
      height: auto;
      padding: 1.5rem 0 0.5rem;
      border-top: 1px solid var(--color-line);
      opacity: 1;
      visibility: visible;
    }
    :global(html:not(.js)) .nav-panel > :global(*) {
      transform: none;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  /* Reduced motion: no movement, and the menu appears and goes at once (the
     global rule shortens durations but not the delay on `visibility`). */
  @media (prefers-reduced-motion: reduce) {
    .nav-panel,
    .nav-panel > :global(*),
    .nav-toggle-bar {
      transition: none !important;
    }
    .nav-panel > :global(*) {
      transform: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('primary-nav');
  const header = toggle?.closest('header');

  if (toggle && panel && header) {
    const openLabel = toggle.dataset.labelOpen || '';
    const closeLabel = toggle.dataset.labelClose || '';
    const mobile = window.matchMedia('(width < 48rem)');
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    // Everything but the header: inert while the menu covers it.
    const behind = () =>
      [...document.body.children].filter(
        (el): el is HTMLElement => el !== header && el instanceof HTMLElement,
      );

    const setOpen = (open: boolean) => {
      if (open) {
        // The sheet fills the viewport under the bar, whatever the bar's height.
        header.style.setProperty('--menu-top', `${header.getBoundingClientRect().bottom}px`);
      }
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      document.documentElement.classList.toggle('menu-open', open);
      behind().forEach((el) => (el.inert = open));
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // A link to the page already shown (or a hash) doesn't unload it: close.
    panel.addEventListener('click', (event) => {
      if (isOpen() && (event.target as Element).closest('a')) setOpen(false);
    });

    // The desktop header has no menu to keep open; a page restored from the
    // back/forward cache comes back closed.
    mobile.addEventListener('change', () => isOpen() && !mobile.matches && setOpen(false));
    window.addEventListener('pageshow', (event) => event.persisted && isOpen() && setOpen(false));
  }
</script>

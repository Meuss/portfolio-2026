---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';
import Arrow from './icons/Arrow.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactHref = localizedPath(lang, '/contact');
const workHref = localizedPath(lang, '/work');

// The wall: real desktop screenshots of shipped sites, split into two columns.
const shots = (await getCollection('projects'))
  .filter((p) => p.data.image && !p.data.nda)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 10);
const columns = [shots.filter((_, i) => i % 2 === 0), shots.filter((_, i) => i % 2 === 1)];
---

<section class="hero relative overflow-hidden border-b border-line bg-paper">
  <div class="relative mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-14 px-6 pb-16 pt-20 md:px-10 md:pt-28 lg:min-h-[min(52rem,calc(100svh-4.5rem))] lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center lg:gap-10 lg:py-24">
    <div class="relative z-10">
      <h1 class="hero-name font-display text-ink">{t('hero.name')}</h1>

      <div aria-hidden="true" class="mt-7 flex max-w-md items-center gap-4">
        <span class="h-px w-16 bg-accent"></span>
        <span class="h-px flex-1 bg-line"></span>
      </div>

      <p class="mt-8 max-w-xl text-lead text-ink">{t('hero.tagline')}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={contactHref} class="btn-primary group">
          {t('hero.cta')}
          <Arrow class="transition-transform duration-200 group-hover:translate-x-0.5" />
        </a>
        <a href={workHref} class="btn-secondary">
          {t('hero.ctaSecondary')}
        </a>
      </div>

      <ul class="mt-14 flex flex-col gap-3 border-t border-line pt-7 font-mono text-caption uppercase text-muted sm:flex-row sm:flex-wrap sm:gap-x-10">
        <li class="flex items-center gap-2.5 text-ink">
          <span aria-hidden="true" class="status-dot"></span>
          {t('hero.availability')}
        </li>
        <li>{t('hero.based')}</li>
      </ul>
    </div>

    {shots.length > 0 && (
      <div class="wall-wrap relative min-w-0" data-wall>
        <div class="wall" aria-hidden="true">
          {columns.map((col, c) => (
            <div class:list={['wall-col', c === 1 && 'wall-col--down']}>
              {/* Rendered twice so the loop is seamless. */}
              {[0, 1].map((copy) => (
                <div class="wall-track">
                  {col.map((p, i) => (
                    <figure class="wall-shot">
                      <Image
                        src={p.data.image!}
                        alt=""
                        widths={[360, 560, 720]}
                        sizes="(min-width: 1024px) 15rem, 60vw"
                        loading={copy === 0 && i < 2 ? 'eager' : 'lazy'}
                        class="block aspect-[16/10] h-auto w-full object-cover object-top"
                      />
                      <figcaption>{p.data.title}</figcaption>
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
        <button
          type="button"
          class="wall-toggle"
          data-wall-toggle
          hidden
          data-label-pause={t('hero.wallPause')}
          data-label-play={t('hero.wallPlay')}
          aria-pressed="false"
        >
          {t('hero.wallPause')}
        </button>
      </div>
    )}
  </div>
</section>

<script>
  const wall = document.querySelector<HTMLElement>('[data-wall]');
  const toggle = wall?.querySelector<HTMLButtonElement>('[data-wall-toggle]');
  const moving = window.matchMedia('(prefers-reduced-motion: no-preference)');
  if (wall && toggle && moving.matches) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const paused = wall.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '';
    });
    // Don't spend frames on a wall nobody can see.
    new IntersectionObserver(([entry]) => {
      wall.classList.toggle('is-offscreen', !entry.isIntersecting);
    }).observe(wall);
  }
</script>

<style>
  .hero-name {
    font-size: clamp(3.25rem, 1.2rem + 7vw, 6rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }

  /* --- The wall of work -------------------------------------------------- */
  .wall-wrap {
    --wall-h: 34rem;
  }
  .wall {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    height: var(--wall-h);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
  }
  .wall-col {
    display: flex;
    flex-direction: column;
  }
  .wall-col--down {
    margin-top: -9rem;
  }
  .wall-track {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .wall-shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .wall-shot figcaption {
    padding: 0.55rem 0.75rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wall-toggle {
    position: absolute;
    right: 0;
    bottom: -2.25rem;
    padding: 0.25rem 0;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .wall-toggle:hover {
    color: var(--color-gilt);
  }

  /* Mobile: one horizontal strip under the intro. */
  @media (max-width: 1023px) {
    .wall-wrap {
      margin-inline: -1.5rem;
      --wall-h: auto;
    }
    .wall {
      display: block;
      height: auto;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    }
    .wall-col {
      flex-direction: row;
      width: max-content;
    }
    .wall-col--down {
      display: none;
    }
    .wall-track {
      flex-direction: row;
      padding: 0 1rem 0 0;
    }
    .wall-shot {
      width: min(16rem, 62vw);
    }
    .wall-toggle {
      right: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .wall-col {
      animation: wall-up 70s linear infinite;
    }
    .wall-col--down {
      animation: wall-down 80s linear infinite;
    }
    .wall-wrap:hover .wall-col,
    .wall-wrap.is-paused .wall-col,
    .wall-wrap.is-offscreen .wall-col {
      animation-play-state: paused;
    }
    @media (max-width: 1023px) {
      .wall-col {
        animation: wall-left 60s linear infinite;
      }
    }
  }
  @keyframes wall-up {
    to {
      transform: translateY(-50%);
    }
  }
  @keyframes wall-down {
    from {
      transform: translateY(-50%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes wall-left {
    to {
      transform: translateX(-50%);
    }
  }
</style>

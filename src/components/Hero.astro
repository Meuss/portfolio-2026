---
import type { Lang } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactHref = localizedPath(lang, '/contact');
const workHref = localizedPath(lang, '/work');
---

<section class="relative overflow-hidden border-b border-line bg-paper">
  {/* Motion mount point — populated in Task 7 (progressive enhancement only). */}
  <div id="hero-motion" aria-hidden="true" class="pointer-events-none absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 py-24 md:px-10 md:py-32 lg:py-40">
    <!-- Eyebrow -->
    <p class="flex items-center gap-3 font-mono text-caption uppercase text-muted">
      <span aria-hidden="true" class="inline-block h-2 w-2 rounded-sm bg-accent"></span>
      {t('hero.eyebrow')}
    </p>

    <!-- Signature: oversized display name -->
    <h1 class="mt-8 font-display text-display text-ink">
      <span class="block">{t('hero.name')}</span>
    </h1>
    <!-- Accent baseline rule (measurement device) -->
    <div aria-hidden="true" class="mt-6 flex items-center gap-4">
      <span class="h-px w-16 bg-accent md:w-24"></span>
      <span class="h-px flex-1 bg-line"></span>
    </div>

    <!-- Positioning line -->
    <p class="mt-8 max-w-2xl text-lead text-ink">
      {t('hero.tagline')}
    </p>

    <!-- Calls to action -->
    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
      <a
        href={contactHref}
        class="inline-flex items-center justify-center gap-2 rounded-sm bg-accent px-7 py-3.5 font-mono text-caption uppercase text-accent-ink no-underline transition-transform duration-200 hover:-translate-y-0.5 hover:text-accent-ink"
      >
        {t('hero.cta')}
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={workHref}
        class="inline-flex items-center justify-center gap-2 rounded-sm border border-line px-7 py-3.5 font-mono text-caption uppercase text-ink no-underline transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        {t('hero.ctaSecondary')}
      </a>
    </div>

    <!-- Credibility meta -->
    <ul class="mt-16 flex flex-col gap-4 border-t border-line pt-8 font-mono text-caption uppercase text-muted sm:flex-row sm:gap-12">
      <li class="flex items-center gap-2.5">
        <span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-accent"></span>
        {t('hero.availability')}
      </li>
      <li>{t('hero.based')}</li>
    </ul>
  </div>
</section>

{/* Signature hero motion — progressive enhancement, loaded after first paint. */}
<script>
  // Skip entirely for reduced-motion users; leave the static hero untouched.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = () =>
      import('./islands/HeroMotion').then((m) => m.initHeroMotion()).catch(() => {});
    if ('requestIdleCallback' in window) {
      requestIdleCallback(start, { timeout: 1500 });
    } else {
      setTimeout(start, 200);
    }
  }
</script>

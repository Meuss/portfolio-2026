---
interface Props {
  /** 'out' = external (↗), 'right' = internal (→). */
  dir?: 'out' | 'right';
  class?: string;
}
const { dir = 'right', class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 16 16"
  width="0.95em"
  height="0.95em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  class:list={['inline-block shrink-0', className]}
>
  {dir === 'out' ? <path d="M5 11 11 5M6 5h5v5" /> : <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5" />}
</svg>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  imageMobile?: ImageMetadata;
  alt: string;
  /** The grid the frame sits in: 2 columns from md on /work, 3 on the
      homepage. Sets the `sizes` hints, so phones get a file near the width
      the frame really has. */
  columns?: 2 | 3;
  eager?: boolean;
  /** Effect slot for the screenshot (islands/fx): differs per page. */
  fxSlot?: 'featuredMedia' | 'workMedia' | 'workTeaser';
}

const { image, imageMobile, alt, columns = 2, eager = false, fxSlot } = Astro.props;

// The frame's width: the page column (max-w-6xl, px-6 then md:px-10) split
// into the grid's columns (gap-x-10 on /work, gap-x-8 on the homepage). The
// phone capture is 22% of it.
const frame =
  columns === 3
    ? { wide: '21rem', md: 'calc(33.3vw - 3rem)', base: 'calc(100vw - 3rem)' }
    : { wide: '32.25rem', md: 'calc(50vw - 3.75rem)', base: 'calc(100vw - 3rem)' };
const sizes = `(min-width: 1152px) ${frame.wide}, (min-width: 768px) ${frame.md}, ${frame.base}`;
const mobileSizes =
  columns === 3
    ? '(min-width: 768px) 4.75rem, 22vw'
    : '(min-width: 1152px) 7.25rem, (min-width: 768px) calc(11vw - 0.8rem), 22vw';
---

{/* A real screenshot of the shipped site on a surface plate; the phone
    capture overlaps the lower-right corner when there is one. */}
<div class="frame relative" data-fx-slot={fxSlot}>
  <div class="frame-desktop overflow-hidden rounded-md border border-line bg-surface">
    {image ? (
      <Image
        src={image}
        alt={alt}
        widths={[480, 640, 800, 1200, 1600]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        class="block aspect-[16/10] h-auto w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.02]"
      />
    ) : (
      <div class="frame-blank aspect-[16/10] w-full" aria-hidden="true">
        <slot name="blank" />
      </div>
    )}
  </div>
  {imageMobile && (
    <div class="frame-mobile absolute -bottom-5 right-4 w-[22%] min-w-[4.5rem] overflow-hidden rounded-lg border border-line bg-paper md:right-6">
      <Image
        src={imageMobile}
        alt=""
        widths={[160, 320]}
        sizes={mobileSizes}
        loading={eager ? 'eager' : 'lazy'}
        class="block aspect-[390/844] h-auto w-full object-cover object-top"
      />
    </div>
  )}
</div>

<style>
  .frame-mobile {
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.7);
  }
  .frame-blank {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 14px),
      var(--color-surface);
  }
</style>

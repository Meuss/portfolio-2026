---
import type { Lang } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';
import Arrow from './icons/Arrow.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/* Each heading line is its own effect host (islands/fx `notFound`): the fuzzy
    variant redraws the line on a canvas and keeps the text for screen readers. */}
<section class="overflow-x-clip border-b border-line bg-paper">
  <div class="mx-auto flex min-h-[calc(100svh-4.5rem)] max-w-6xl flex-col justify-center px-6 py-20 md:px-10">
    <h1 class="font-display text-ink">
      <span class="not-found-code block" data-fx-slot="notFound">
        {t('notFound.line1')}
      </span>
      <span class="mt-3 block text-headline" data-fx-slot="notFound">
        {t('notFound.line2')}
      </span>
    </h1>

    <div class="mt-12">
      <a href={localizedPath(lang, '/')} class="btn-primary group" data-fx-slot="primaryButton">
        {t('notFound.home')}
        <Arrow class="transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>
    </div>
  </div>
</section>

<style>
  .not-found-code {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: 700;
  }
</style>

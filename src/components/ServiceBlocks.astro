---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { headlineServices, capabilities } from '../data/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-b border-line bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div class="grid grid-cols-1 gap-12 lg:gap-14">
      <header class="max-w-3xl">
        <h2 class="font-display text-headline text-ink">{t('services.heading')}</h2>
        <p class="mt-5 text-lead text-muted">{t('services.intro')}</p>
      </header>

      <!-- The five services as tiles: one column on phones; from `sm`, two
           tracks with the first tile across both; from `lg`, three tracks with
           the first tile two wide beside the second, then the other three in a
           row. Each tile is a `surface` plate with a 1px `line` rim, a muted
           mono index at the top and its title and blurb at the bottom.
           `servicesTiles` effect slot: light in the tiles under the pointer
           (islands/fx/effects.ts). -->
      <div data-fx-slot="servicesTiles">
        <ol class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {headlineServices.map((service, i) => (
            <li
              data-reveal
              data-reveal-delay={String((i % 3) + 1)}
              class="service relative flex flex-col gap-2 p-6 sm:first:col-span-2 lg:p-7"
            >
              <div class="service-plate" aria-hidden="true" />
              <span
                class="service-index relative z-1 mb-auto pb-5 font-mono text-caption text-muted"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="relative z-1 font-display text-title text-ink">{service.title[lang]}</h3>
              <p class="relative z-1 max-w-[42ch] text-body text-muted">{service.blurb[lang]}</p>
            </li>
          ))}
        </ol>

        <div class="mt-12" data-reveal>
          <h3 class="font-mono text-caption uppercase text-muted">{t('capabilities.heading')}</h3>
          <ul class="mt-5 grid gap-x-10 gap-y-5 sm:grid-cols-2" role="list">
            {capabilities.map((cap) => (
              <li>
                <p class="text-body text-ink">{cap.title[lang]}</p>
                <p class="mt-1 text-small text-muted">{cap.blurb[lang]}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* A tile's plate, behind its text: the effect paints its light inside it. */
  .service-plate {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    pointer-events: none;
  }
</style>

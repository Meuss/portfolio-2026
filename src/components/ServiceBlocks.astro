---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { headlineServices } from '../data/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// frontend-craft (index 1) is pulled out as the emphasised feature block;
// the rest keep their source order in a supporting grid.
const feature = headlineServices[1];
const rest = headlineServices.filter((_, i) => i !== 1);
---

<section class="border-b border-line bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <!-- Section header -->
    <header class="max-w-2xl">
      <h2 class="font-display text-headline text-ink">{t('services.heading')}</h2>
      <p class="mt-4 text-lead text-muted">{t('services.intro')}</p>
    </header>

    <div class="mt-12 grid gap-4 md:mt-16">
      <!-- Feature block: frontend craft — the "main plate" -->
      <article
        data-reveal
        class="group relative overflow-hidden rounded-md border border-line bg-surface p-8 md:p-12"
      >
        <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gilt/70"></span>
        <h3 class="max-w-xl font-display text-title text-ink">{feature.title[lang]}</h3>
        <p class="mt-3 max-w-xl text-lead text-muted">{feature.blurb[lang]}</p>
      </article>

      <!-- Supporting blocks -->
      <div class="grid gap-4 sm:grid-cols-2">
        {
          rest.map((service, i) => (
            <article
              data-reveal
              data-reveal-delay={String((i % 3) + 1)}
              class="group rounded-md border border-line bg-surface p-8 transition-colors duration-200 hover:border-gilt"
            >
              <h3 class="font-display text-title text-ink">{service.title[lang]}</h3>
              <p class="mt-3 text-body text-muted">{service.blurb[lang]}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

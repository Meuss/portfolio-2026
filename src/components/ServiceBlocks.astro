---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { headlineServices, capabilities } from '../data/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-b border-line bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-20">
      <header class="lg:sticky lg:top-28 lg:self-start">
        <h2 class="font-display text-headline text-ink">{t('services.heading')}</h2>
        <p class="mt-5 text-lead text-muted">{t('services.intro')}</p>
      </header>

      <div>
        <ol class="border-b border-line" role="list">
          {headlineServices.map((service, i) => (
            <li
              data-reveal
              data-reveal-delay={String((i % 3) + 1)}
              class="service grid gap-2 border-t border-line py-7 sm:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] sm:gap-10 md:py-8"
            >
              <h3 class="font-display text-title text-ink">{service.title[lang]}</h3>
              <p class="text-body text-muted sm:pt-1.5">{service.blurb[lang]}</p>
            </li>
          ))}
        </ol>

        <div class="mt-12" data-reveal>
          <h3 class="font-mono text-caption uppercase text-gilt">{t('capabilities.heading')}</h3>
          <ul class="mt-5 flex flex-wrap gap-2" role="list">
            {capabilities.map((cap) => (
              <li
                class="rounded-sm border border-line px-3 py-1.5 font-mono text-caption uppercase text-ink"
                title={cap.blurb[lang]}
              >
                {cap.title[lang]}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .service h3 {
    transition: color 0.25s;
  }
  .service:hover h3 {
    color: var(--color-gilt);
  }
</style>

---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { capabilities } from '../data/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-b border-line bg-surface py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div class="grid gap-10 md:grid-cols-[minmax(0,16rem)_1fr] md:gap-16">
      <!-- Light section label -->
      <header data-reveal>
        <p class="flex items-center gap-3 font-mono text-caption uppercase text-muted">
          <span aria-hidden="true" class="inline-block h-2 w-2 rounded-sm bg-accent"></span>
          {t('capabilities.eyebrow')}
        </p>
        <p class="mt-4 text-body text-muted">{t('capabilities.lead')}</p>
      </header>

      <!-- Inline capability list -->
      <ul
        data-reveal
        data-reveal-delay="1"
        class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          capabilities.map((cap) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-1 font-mono text-caption text-accent">
                +
              </span>
              <div>
                <p class="font-mono text-small font-medium text-ink">{cap.title[lang]}</p>
                <p class="mt-1 text-small text-muted">{cap.blurb[lang]}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

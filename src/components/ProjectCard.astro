---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ProjectFrame from './ProjectFrame.astro';
import Arrow from './icons/Arrow.astro';
import ExternalLink from './icons/ExternalLink.astro';
import ContextBadge from './ContextBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  eager?: boolean;
  fxSlot?: 'featuredMedia' | 'workMedia';
  /** The grid the card sits in (see ProjectFrame): 2 on /work, 3 on the homepage. */
  columns?: 2 | 3;
}

const { project, lang, eager = false, fxSlot, columns = 2 } = Astro.props;
const t = useTranslations(lang);
const { title, context, kind, description, tech, image, imageMobile, link, status, nda } =
  project.data;

const hasLink = Boolean(link) && !nda;
const displayLink = link ? new URL(link).hostname.replace(/^www\./, '') : undefined;
const alt = t('project.screenshotAlt').replace('{name}', title);
---

<article data-context={context} class="project group grid gap-8">
  <div class="pb-5">
    {hasLink ? (
      <a href={link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
        <ProjectFrame
          image={image}
          imageMobile={imageMobile}
          alt=""
          eager={eager}
          columns={columns}
          fxSlot={fxSlot}
        />
      </a>
    ) : (
      <ProjectFrame
        image={image}
        imageMobile={imageMobile}
        alt={image ? alt : ''}
        eager={eager}
        columns={columns}
        fxSlot={fxSlot}
      >
        {nda && (
          <span slot="blank" class="font-mono text-caption uppercase text-muted">
            {t('project.ndaFrame')}
          </span>
        )}
      </ProjectFrame>
    )}
  </div>

  <div class="flex flex-col gap-4">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-caption uppercase text-muted">
      <span class="text-ink">
        <ContextBadge context={context} lang={lang} />
        <span class="sr-only">, </span>
      </span>
      <span aria-hidden="true" class="text-line">
        /
      </span>
      <span>{kind[lang]}</span>
    </p>

    <h3 class="font-display text-title text-ink">
      {hasLink ? (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link text-ink no-underline"
        >
          <span class="project-link-text">{title}</span>
          <span class="new-tab-mark text-muted">
            &#8288;
            <ExternalLink />
          </span>
          <span class="sr-only"> ({t('project.newTab')})</span>
        </a>
      ) : (
        title
      )}
    </h3>

    <p class="max-w-[60ch] text-body text-muted">{description[lang]}</p>

    {tech.length > 0 && (
      <p class="font-mono text-caption uppercase text-muted">
        <span class="sr-only">{t('project.stackLabel')}: </span>
        {tech
          .map((tag) => (tag === 'Multilingual' ? t('project.tagMultilingual') : tag))
          .join(' · ')}
      </p>
    )}

    <div class="pt-1 font-mono text-caption uppercase">
      {hasLink ? (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          aria-hidden="true"
          class="-my-2 inline-flex items-center gap-2 py-2 text-accent no-underline"
        >
          {displayLink}
          <Arrow dir="out" class="arrow" />
        </a>
      ) : status === 'soon' ? (
        <span class="text-muted">{t('project.soon')}</span>
      ) : nda ? (
        <span class="inline-flex items-center gap-2 text-muted">
          <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-current" />
          {t('project.nda')}
        </span>
      ) : null}
    </div>
  </div>
</article>

<style>
  /* One real link per card (the title). The screenshot and the hostname line
     are clickable too, but aria-hidden and out of the tab order, so keyboard
     and screen-reader users don't meet the same link three times. */
  .project-link-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project:hover .project-link-text,
  .project-link:focus-visible .project-link-text {
    background-size: 100% 1px;
  }
  /* New-tab mark beside the title: hidden until the card is hovered or the
     link has keyboard focus. It always keeps its space, so nothing shifts.
     The wrapper stays inline and starts with a word joiner, which glues the
     mark to the last word of the title so it never wraps onto its own line. */
  .new-tab-mark {
    margin-left: 0.3em;
    font-size: 0.55em;
    white-space: nowrap;
  }
  .new-tab-mark :global(svg) {
    vertical-align: 0.12em;
    opacity: 0;
  }
  .project:hover .new-tab-mark :global(svg),
  .project-link:focus-visible .new-tab-mark :global(svg) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .new-tab-mark :global(svg) {
      transform: translate(-2px, 2px);
      transition:
        opacity 0.25s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .project:hover .new-tab-mark :global(svg),
    .project-link:focus-visible .new-tab-mark :global(svg) {
      transform: none;
    }
  }
  .project :global(.arrow) {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project:hover :global(.arrow) {
    transform: translate(2px, -2px);
  }
</style>

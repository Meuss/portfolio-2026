# Copy this file to .env and fill in real values for local development.
# .env itself is gitignored — never commit real secrets.

# Web3Forms access key used by the /contact form (src/pages/[lang]/contact.astro).
# Get one for free at https://web3forms.com — it's a build-time PUBLIC_ var, so
# it ends up in the client bundle; that's expected for Web3Forms' model.
# The build and the form both tolerate this being empty: the page still
# renders, submissions just won't deliver until a real key is set.
PUBLIC_WEB3FORMS_KEY=
